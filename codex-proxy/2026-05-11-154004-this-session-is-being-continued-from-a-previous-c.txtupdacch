⏺ That's the proxy correctly failing because your ~/.codex/auth.json is in
  apikey mode (no OAuth tokens) but the default profile director doesn't specify
   authMode, so it falls through to OAuth — which has no tokens to use.

  Cleanest fix: auto-detect from auth.json's own auth_mode field. If codex login
   --api-key rewrote auth.json to auth_mode: "apikey", the proxy should default
  to api_key without you having to set anything. Adding this now:

⏺ Update(src/auth.ts)
  ⎿  Added 31 lines
      419  export function isApiKeyEnvSet(): boolean {
      420    return !!API_KEY_ENV;
      421  }
      422 +                                                              
      423 +/**                                                           
      424 + * Read auth.json's auth_mode field. Returns "api_key" if it's
          + "apikey"/"api_key",                                          
      425 + * "oauth" if it's "oauth" or any token-shaped mode, null if u
          +nreadable or absent.                                          
      426 + * Cached because auth.json is rewritten infrequently (only on
          + `codex login`).                                              
      427 + */                                                           
      428 +let cachedAuthFileMode: "api_key" | "oauth" | null | undefined
          + = undefined;                                                 
      429 +export function getAuthFileMode(): "api_key" | "oauth" | null 
          +{                                                             
      430 +  if (cachedAuthFileMode !== undefined) return cachedAuthFileM
          +ode;                                                          
      431 +  try {                                                       
      432 +    const raw = readFileSync(AUTH_PATH, "utf8");              
      433 +    const parsed = JSON.parse(raw) as AuthFile;               
      434 +    const m = (readString(parsed.auth_mode) || "").toLowerCase
          +();                                                           
      435 +    if (m === "apikey" || m === "api_key") {                  
      436 +      cachedAuthFileMode = "api_key";                         
      437 +    } else if (m === "oauth" || m === "chatgpt") {            
      438 +      cachedAuthFileMode = "oauth";                           
      439 +    } else if (parsed.tokens?.access_token) {                 
      440 +      // No auth_mode field but has OAuth tokens — legacy file
          + shape                                                        
      441 +      cachedAuthFileMode = "oauth";                           
      442 +    } else if (parsed.OPENAI_API_KEY || (parsed as any).api_ke
          +y) {                                                          
      443 +      // Has an API key field but no auth_mode — treat as api_
          +key                                                           
      444 +      cachedAuthFileMode = "api_key";                         
      445 +    } else {                                                  
      446 +      cachedAuthFileMode = null;                              
      447 +    }                                                         
      448 +  } catch {                                                   
      449 +    cachedAuthFileMode = null;                                
      450 +  }                                                           
      451 +  return cachedAuthFileMode;                                  
      452 +}                                                             

