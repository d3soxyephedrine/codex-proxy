      321 +function previewKey(key: string): string {                    
      322 +  // sk-...XXXX → sk-XXX…YYY  (so we can confirm it loaded wit
          +hout leaking it)                                              
      323 +  if (key.length <= 8) return "***";                          
      324 +  const tail = key.slice(-3);                                 
