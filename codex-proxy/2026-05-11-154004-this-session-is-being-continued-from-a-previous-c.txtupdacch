      338 +// Sibling of applyInstructionsMode, for chat-completions mess
          +ages[0].content.                                              
      339 +// Same four modes, applied to the system message string.     
      340 +export function applySystemMessageMode(                       
      341 +  currentSystem: string,                                      
      342 +  ours: string | undefined,                                   
      343 +  mode: ProfileDef["systemMessageMode"] | undefined,          
      344 +): { result: string; applied: boolean; mode: "replace" | "prep
          +end" | "append" | "wrap" } {                                  
      345 +  if (!ours || ours.length === 0) return { result: currentSyst
          +em, applied: false, mode: "replace" };                        
      346 +  const m = mode || "replace";                                
      347 +  switch (m) {                                                
      348 +    case "replace":                                           
      349 +      return { result: ours, applied: true, mode: m };        
      350 +    case "prepend":                                           
      351 +      return { result: currentSystem ? `${ours}\n\n${currentSy
          +stem}` : ours, applied: true, mode: m };                      
      352 +    case "append":                                            
      353 +      return { result: currentSystem ? `${currentSystem}\n\n${
          +ours}` : ours, applied: true, mode: m };                      
      354 +    case "wrap":                                              
      355 +      return { result: `[BEGIN_PROXY_INSTRUCTIONS]\n${ours}\n[
          +END_PROXY_INSTRUCTIONS]\n\n${currentSystem || ""}`.trim(), app
          +lied: true, mode: m };                                        
      356 +  }                                                           
      357 +}                                                             
      358 +                                                              
      359 +// Mutate the body.messages array so messages[0] (the system r
          +ole) carries the                                              
      360 +// profile-supplied system text. Returns the mutation result. 
          +Handles both string                                           
      361 +// and array-of-content-parts forms of message.content.       
      362 +export function mutateMessagesSystemPrompt(                   
      363 +  messages: any[],                                            
      364 +  ours: string,                                               
      365 +  mode: ProfileDef["systemMessageMode"] | undefined,          
      366 +): { messages: any[]; applied: boolean; mode: string; original
          +Len: number; finalLen: number } {                             
      367 +  if (!Array.isArray(messages) || messages.length === 0) {    
      368 +    return { messages, applied: false, mode: "replace", origin
          +alLen: 0, finalLen: 0 };                                      
      369 +  }                                                           
      370 +  const first = messages[0];                                  
      371 +  if (!first || typeof first !== "object") {                  
      372 +    return { messages, applied: false, mode: "replace", origin
          +alLen: 0, finalLen: 0 };                                      
      373 +  }                                                           
      374 +                                                              
      375 +  // Read current system content (handle both string and array
          +-of-parts shapes)                                             
      376 +  let currentText = "";                                       
      377 +  if (first.role === "system") {                              
      378 +    if (typeof first.content === "string") {                  
      379 +      currentText = first.content;                            
      380 +    } else if (Array.isArray(first.content)) {                
      381 +      currentText = first.content                             
      382 +        .filter((p: any) => p && typeof p === "object" && type
          +of p.text === "string")                                       
      383 +        .map((p: any) => p.text)                              
      384 +        .join("");                                            
      385 +    }                                                         
      386 +  }                                                           
      387 +                                                              
      388 +  const { result, applied, mode: resolvedMode } = applySystemM
          +essageMode(currentText, ours, mode);                          
      389 +  if (!applied) {                                             
      390 +    return { messages, applied: false, mode: resolvedMode, ori
          +ginalLen: currentText.length, finalLen: currentText.length }; 
      391 +  }                                                           
      392 +                                                              
      393 +  // Write result back. Normalize to string content for simpli
          +city; both shapes                                             
      394 +  // are equivalent on the wire for OpenAI's chat-completions 
          +endpoint.                                                     
      395 +  const newFirst = { ...first, role: "system", content: result
          + };                                                           
      396 +  const newMessages = first.role === "system"                 
      397 +    ? [newFirst, ...messages.slice(1)]                        
      398 +    : [newFirst, ...messages];  // no existing system message 
          +→ prepend ours                                                
      399 +                                                              
      400 +  return { messages: newMessages, applied: true, mode: resolve
          +dMode, originalLen: currentText.length, finalLen: result.lengt
          +h };                                                          
      401 +}                                                             
